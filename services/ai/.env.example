# Copy to .env (gitignored). Never commit a real key.

# Gemini API key. Without it the service starts and AI jobs answer 503.
GEMINI_API_KEY=

# Model IDs. Must be listed in allowlist.json for the job.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_SCOPE=
# GEMINI_MODEL_VERIFY=

HOST=127.0.0.1
PORT=3200
LOG_LEVEL=info

# Request body cap (deliverables included), in MB.
MAX_PAYLOAD_MB=200

# Per-wallet token bucket: burst size and refill rate.
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_MINUTE=6

MODEL_TIMEOUT_MS=120000
# Extra attempts when the model errors or its output fails validation.
MODEL_RETRIES=1
