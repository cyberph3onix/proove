    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
