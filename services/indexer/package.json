{
  "name": "@proove/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
