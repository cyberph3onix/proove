# Privy app credentials — https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# mock (default) reads the seeded in-browser chain; chain reads indexer + RPC.
NEXT_PUBLIC_DATA_MODE=mock

# Chain mode only.
NEXT_PUBLIC_CLUSTER=localnet
# Override the cluster defaults if needed.
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
# NEXT_PUBLIC_USDC_MINT=<mint from deployments/localnet.json>
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:4100
# Delivery Verifier; leave blank to disable AI checks.
NEXT_PUBLIC_AI_URL=http://127.0.0.1:3200
