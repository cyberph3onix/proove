  "types": [
    {
      "name": "Achievement",
      "docs": [
        "One PDA per (owner, badge_type). Existence + `claimed = true` is the",
        "on-chain record that the badge's NFT has been minted; the PDA's `init`",
        "constraint at claim time is what makes a duplicate claim impossible."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "owner",
            "type": "pubkey"
          },
          {
            "name": "badge_type",
            "type": {
              "defined": {
                "name": "BadgeType"
              }
            }
          },
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "claimed",
            "type": "bool"
          },
          {
            "name": "claimed_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
